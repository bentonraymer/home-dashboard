{
  "name": "home-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Apple TV-style ambient home dashboard: calendar, todos, weather, music, news, sports.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server",
    "check": "tsc -p server --noEmit && svelte-check --workspace web --tsconfig ./tsconfig.json",
    "start": "node dist/server/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "node-ical": "^0.27.3",
    "pngjs": "^7.0.0",
    "rss-parser": "^3.13.0",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/suncalc": "^1.9.2",
    "concurrently": "^10.0.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
