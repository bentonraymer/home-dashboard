# Copy this file to .env and fill in what you use. Leave a value blank to turn
# that integration off. This file is read by docker compose; never commit .env.

# Time zone for the server (used for all-day events). List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Denver

# PIN for the /settings page. The dashboard itself stays open on your network.
SETTINGS_PIN=

# Calendars: comma-separated, each "url", "Name|url" or "Name|#color|url".
# Google Calendar: Settings → (your calendar) → Integrate calendar → "Secret address in iCal format".
CALENDAR_URLS=

# Todoist: Settings → Integrations → Developer → API token.
TODOIST_TOKEN=

# Unsplash wallpapers: create an app at https://unsplash.com/oauth/applications and use its Access Key.
# Blank = use the photos built into the image.
UNSPLASH_ACCESS_KEY=

# Spotify Now Playing: create an app at https://developer.spotify.com/dashboard,
# add the redirect URI below to it, then click "Connect Spotify" in /settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Defaults to http://127.0.0.1:8080/auth/spotify/callback. Spotify only accepts
# https:// addresses or 127.0.0.1, so use https here if you run a reverse proxy.
SPOTIFY_REDIRECT_URI=
